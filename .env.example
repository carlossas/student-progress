# Copy to `.env` (gitignored) and fill in. The gate reads it on every `python -m gate ...`
# and `pytest -m ai`. Real environment variables win; CI uses repository secrets instead.

# Required for the AI pipeline. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=LOW
